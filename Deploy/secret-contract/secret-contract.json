{
  "schema_version": 1,
  "secrets": [
    {
      "id": "tmxy.postgres.superuser_password",
      "development_path_variable": "TMXY_POSTGRES_PASSWORD_FILE",
      "container_target": "/run/secrets/tmxy_postgres_password",
      "allowed_sources": [
        "operator_managed_file_outside_repository",
        "ci_secret_store_file",
        "orchestrator_secret_store_mount"
      ],
      "forbidden_sources": [
        "source_code",
        "git",
        "git_lfs",
        "command_line_argument",
        "container_image",
        "log"
      ],
      "rotation_owner": "platform_security",
      "rotation_interval_days": 90
    }
  ]
}
