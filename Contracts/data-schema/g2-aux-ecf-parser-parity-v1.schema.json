      "type": "object", "additionalProperties": false,
      "required": ["policy_sha256", "schema_sha256", "detail_schema_sha256"],
      "properties": {"policy_sha256": {"$ref": "#/$defs/sha256"}, "schema_sha256": {"$ref": "#/$defs/sha256"}, "detail_schema_sha256": {"$ref": "#/$defs/sha256"}}
    },
