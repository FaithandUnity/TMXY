{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tmxy:g2-aux-ecf-parser-parity:v1",
  "title": "TMXY P2-20A.10 ECF parser-parity diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": [
