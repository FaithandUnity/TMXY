{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmxy.invalid/contracts/asset-interchange-v1.schema.json",
  "title": "TMXY asset interchange bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "format_version",
    "bundle_id",
    "asset_kind",
    "producer",
    "source_inputs",
    "artifacts",
    "unknown_fields",
    "extensions"
  ],
  "properties": {
    "schema": { "const": "tmxy.asset.interchange" },
    "schema_version": { "const": 1 },
    "format_version": { "const": "1.0.0" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "asset_kind": {
      "enum": [
        "package_tree",
        "texture",
        "static_mesh",
        "skeletal_mesh",
        "animation_set",
        "terrain_tile",
        "audio",
        "navigation_graph",
        "ui_texture",
        "material"
      ]
    },
    "producer": { "$ref": "#/$defs/producer" },
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceInput" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "unknown_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknownField" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "relative_path", "bytes", "sha256", "copy_policy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "copy_policy": { "const": "reference-only" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_role",
        "relative_path",
        "format_id",
        "format_version",
        "media_type",
        "authority",
        "byte_order",
        "coordinate_contract",
        "unit_contract",
        "bytes",
        "sha256",
        "depends_on",
        "required_features",
        "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "semantic_role": { "$ref": "#/$defs/id" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "format_id": { "$ref": "#/$defs/id" },
        "format_version": { "$ref": "#/$defs/semver" },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "authority": {
          "enum": ["authoritative-interchange", "review", "diagnostic", "evidence-only"]
        },
        "byte_order": { "enum": ["little-endian", "not-applicable"] },
        "coordinate_contract": {
          "enum": [
            "not-spatial",
            "legacy-runtime-x-forward-y-right-z-up-meters",
            "ue-x-forward-y-right-z-up-centimeters",
            "gltf-2.0-standard"
          ]
        },
        "unit_contract": {
          "enum": ["not-applicable", "source-units", "meters", "centimeters", "seconds"]
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "required_features": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_input_id", "offset", "size"],
      "properties": {
        "source_input_id": { "$ref": "#/$defs/id" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "unknownField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "preservation", "reason", "extensions"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "state": { "enum": ["unparsed", "unmapped", "unsupported"] },
        "preservation": {
          "enum": ["source-span", "opaque-sidecar", "namespaced-extension"]
        },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "extension_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "oneOf": [
        {
          "properties": { "preservation": { "const": "source-span" } },
          "required": ["source_span"]
        },
        {
          "properties": { "preservation": { "const": "opaque-sidecar" } },
          "required": ["artifact_id"]
        },
        {
          "properties": { "preservation": { "const": "namespaced-extension" } },
          "required": ["extension_key"]
        }
      ]
    }
  }
}
