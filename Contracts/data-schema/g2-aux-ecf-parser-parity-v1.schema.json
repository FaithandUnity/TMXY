        "immutable_baseline": {"const": true},
        "instances": {"const": 64},
        "parity_instances": {"const": 61},
        "difference_instances": {"const": 3},
        "legacy_pair_count_delta": {"const": 4},
        "a3_only_pair_records": {"const": 3},
        "legacy_only_pair_records": {"const": 7},
