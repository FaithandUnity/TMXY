        "config_occurrences": {"$ref": "#/$defs/nonnegative"}, "config_edges": {"$ref": "#/$defs/nonnegative"}, "config_unique": {"$ref": "#/$defs/nonnegative"}, "config_ambiguous": {"$ref": "#/$defs/nonnegative"},
