        "left_pair_records": {"$ref": "#/$defs/nonnegative"}, "right_pair_records": {"$ref": "#/$defs/nonnegative"},
        "shared_pair_records": {"$ref": "#/$defs/nonnegative"}, "left_only_pair_records": {"$ref": "#/$defs/nonnegative"},
        "right_only_pair_records": {"$ref": "#/$defs/nonnegative"}, "difference_set_sha256": {"$ref": "#/$defs/sha256"}
