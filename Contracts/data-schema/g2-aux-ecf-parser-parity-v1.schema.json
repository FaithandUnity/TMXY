      "type": "object", "additionalProperties": false,
      "required": ["tracked_aggregate_and_hash_only", "anonymous_detail_only", "raw_values", "key_names", "file_names", "private_source_paths", "source_line_numbers", "legacy_source_lines", "exact_primary_keys", "decoded_payloads"],
      "properties": {
        "tracked_aggregate_and_hash_only": {"const": true}, "anonymous_detail_only": {"const": true},
        "raw_values": {"const": false}, "key_names": {"const": false}, "file_names": {"const": false},
        "private_source_paths": {"const": false}, "source_line_numbers": {"const": false},
        "legacy_source_lines": {"const": false}, "exact_primary_keys": {"const": false},
        "decoded_payloads": {"const": false}
      }
