      "properties": {
        "legacy_runtime_executed": {"const": false}, "runtime_binary_parity_claimed": {"const": false},
        "a3_outputs_modified": {"const": false}, "valid_semantic_assignments_claimed": {"const": false},
        "consumer_contract_approved": {"const": false}, "semantic_adapter_approved": {"const": false},
        "no_reference_approved": {"const": false}, "root_approved": {"const": false},
