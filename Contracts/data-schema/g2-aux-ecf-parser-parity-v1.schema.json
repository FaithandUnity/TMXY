    "detailBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["tracked", "path", "lines", "bytes", "sha256"],
      "properties": {"tracked": {"const": false}, "path": {"const": "Data/Exports/P2-20/p2-20a-aux-ecf-parser-parity.jsonl"}, "lines": {"const": 64}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
