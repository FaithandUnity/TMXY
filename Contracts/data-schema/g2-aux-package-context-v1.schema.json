            {"allOf": [{"$ref": "#/$defs/tracked_binding"}, {"properties": {"role": {"const": "package_object_reader"}, "sha256": {"const": "b4abf66d3f84f583f80f88b70c44e7c90fcac9fd380c34f08f398cf3e8ccd064"}}}]},
