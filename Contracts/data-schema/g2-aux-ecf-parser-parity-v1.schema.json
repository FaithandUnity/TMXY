      "type": "object", "additionalProperties": false,
      "required": ["scope", "ecf", "global", "controls"],
      "properties": {
        "scope": {"const": "CANDIDATE_ONLY_NON_MUTATING_PROJECTION"},
        "ecf": {
          "type": "object", "additionalProperties": false,
          "required": ["frozen_a3", "correct_transform_a3_filter", "source_derived_legacy_pairs"],
