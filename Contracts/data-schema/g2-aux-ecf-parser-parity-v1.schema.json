        "selection_count": {"const": 0}, "approved_roots": {"const": 0},
        "approved_consumer_contracts": {"const": 0}, "approved_semantic_adapters": {"const": 0},
        "approved_no_reference_instances": {"const": 0}, "terminal_instances": {"const": 0},
        "semantic_imports_claimed": {"const": 0}
