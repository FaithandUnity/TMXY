{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmxy.invalid/contracts/core-data-model-v1.schema.json",
  "title": "TMXY core data code-generation model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "task_id", "source", "policy", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_id": { "const": "tmxy-core-data-model-v1" },
    "task_id": { "const": "P2-17" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_table_registry_sha256", "id_limit_audit_sha256"],
      "properties": {
        "core_table_registry_sha256": { "$ref": "#/$defs/sha256" },
        "id_limit_audit_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "numeric_identity_storage", "narrowing"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "numeric_identity_storage": { "const": "uint64" },
        "narrowing": { "const": "forbidden" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "name", "id_type", "record_type", "fields"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "id_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Id$" },
        "record_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Record$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_id", "name", "source_type", "nullable", "role", "storage_type"],
      "properties": {
        "column_id": { "type": "string", "pattern": "^c[0-9]{4}$" },
        "name": { "type": "string", "pattern": "^C[0-9]{4}$" },
        "source_type": { "enum": ["int64", "decimal", "string"] },
        "nullable": { "type": "boolean" },
        "role": { "enum": ["identity-component", "value"] },
        "storage_type": { "enum": ["uint64", "int64", "double", "utf8-string"] }
      }
    }
  }
}
